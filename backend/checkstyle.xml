<?xml version="1.0"?>
<!DOCTYPE module PUBLIC "-//Checkstyle//DTD Checkstyle Configuration 1.3//EN"
    "https://checkstyle.org/dtds/configuration_1_3.dtd">
<!--
  Placement Platform — Checkstyle configuration.

  Intentionally minimal: enforces only rules that catch real bugs
  without conflicting with the existing code style or Lombok.
  Test sources are excluded (see maven-checkstyle-plugin config).
-->
<module name="Checker">
    <property name="charset" value="UTF-8"/>
    <property name="severity" value="error"/>
    <property name="fileExtensions" value="java"/>

    <module name="TreeWalker">

        <!-- No sun.* / com.sun.* internal API — use java.* or javax.* equivalents -->
        <module name="IllegalImport">
            <property name="illegalPkgs" value="sun, com.sun"/>
        </module>

        <!--
          Empty catch blocks must explain WHY the exception is swallowed.
          Variable names "expected", "ignored", or "noop" are also accepted
          as a signal that the empty body is intentional.
        -->
        <module name="EmptyCatchBlock">
            <property name="exceptionVariableName" value="expected|ignored|noop"/>
        </module>

        <!-- Never compare String objects with == or != — always use .equals() -->
        <module name="StringLiteralEquality"/>

    </module>
</module>
