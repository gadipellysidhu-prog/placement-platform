# ─────────────────────────────────────────────────────────────────────────────
# Placement Intelligence & Skill Verification Platform — Environment Template
# ─────────────────────────────────────────────────────────────────────────────
# Development:  cp .env.example .env      (defaults work against docker-compose.dev.yml)
# Production:   cp .env.example .env.prod  (fill in every value marked REQUIRED)
# .env and .env.prod are git-ignored — NEVER commit files containing real secrets.
# ─────────────────────────────────────────────────────────────────────────────

# ── Spring Profile ─────────────────────────────────────────────────────────
# dev | test | prod
SPRING_PROFILES_ACTIVE=dev

# ── Database ───────────────────────────────────────────────────────────────
# Dev defaults match docker-compose.dev.yml.
# In docker-compose.prod.yml, DB_URL is constructed automatically from the
# postgres service hostname — only set DB_NAME/DB_USERNAME/DB_PASSWORD.
DB_NAME=placement_dev
DB_URL=jdbc:postgresql://localhost:5432/placement_dev
DB_USERNAME=placement_user
DB_PASSWORD=dev_password_123

# ── Server ─────────────────────────────────────────────────────────────────
SERVER_PORT=8081

# ── JWT RS256 Key Pair ─────────────────────────────────────────────────────
# If left empty an ephemeral key pair is generated at startup (DEV ONLY --
# all tokens become invalid on every restart).
#
# Production: use the bundled key generator (works on Windows, macOS, Linux):
#   .\scripts\generate-prod-keys.ps1          # PowerShell
#   bash scripts/generate-prod-keys.sh        # (if a bash wrapper exists)
#
# The script writes single-line base64 DER values (no PEM headers, no newlines).
# JwtService.decodePem() accepts this format directly.
# Docker Compose env files do NOT support multiline PEM -- always use single-line base64.
JWT_PRIVATE_KEY_PEM=
JWT_PUBLIC_KEY_PEM=

# Token expiry (milliseconds)
JWT_ACCESS_EXPIRY_MS=900000       # 15 minutes
JWT_REFRESH_EXPIRY_MS=604800000   # 7 days

# JWT claims (used to validate token issuer)
JWT_ISSUER=placement-platform
JWT_AUDIENCE=placement-api

# ── CORS ───────────────────────────────────────────────────────────────────
# Comma-separated allowed frontend origins (no trailing slash).
# Dev defaults: localhost:3000, :5173 and :5174 are set in application.yml.
# Production: REQUIRED — empty string disables all cross-origin requests.
# Example: https://app.example.com,https://admin.example.com
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173,http://localhost:5174

# ── File Upload ────────────────────────────────────────────────────────────
FILE_MAX_SIZE_BYTES=10485760      # 10 MB
FILE_MAX_MULTIPART_SIZE=10MB
FILE_UPLOAD_DIR=./uploads

# ── ClamAV Antivirus ───────────────────────────────────────────────────────
# Set FILE_SCAN_ENABLED=true and point to a running ClamAV daemon.
# Dev: enable only when using docker-compose.dev.yml (includes clamav service).
# Test: always false (overridden in application-test.yml).
FILE_SCAN_ENABLED=false
CLAMAV_HOST=localhost
CLAMAV_PORT=3310
CLAMAV_TIMEOUT_MS=30000

# ── Application Version ─────────────────────────────────────────────────────
# Used by docker-compose.prod.yml to tag the built image.
APP_VERSION=1.0.0
