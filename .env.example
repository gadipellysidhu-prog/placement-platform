# Copy to .env and adjust for your machine:  cp .env.example .env
# .env is git-ignored and must NEVER be committed.

# Spring profile: dev | test | prod
SPRING_PROFILES_ACTIVE=dev

# Database (defaults match docker-compose.dev.yml for dev; REQUIRED with no default in prod)
DB_URL=jdbc:postgresql://localhost:5432/placement_dev
DB_USERNAME=placement_user
DB_PASSWORD=dev_password_123

# Server port (optional, defaults to 8080)
# SERVER_PORT=8080
