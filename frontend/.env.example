# Copy this file to .env (or .env.local) and adjust values for your machine.
# Never commit the real .env file -- it is gitignored.
#
# All variables are validated at startup by src/config/env.ts (zod schema).
# If a required variable is missing or malformed, the app throws immediately
# on load instead of failing silently later.

# Base URL of the backend API (required, must be a valid absolute URL).
# Matches the Spring Boot backend's dev port (see backend/CLAUDE.md / RUNBOOK.md).
VITE_API_BASE_URL=http://localhost:8081

# Display name shown in the UI (optional, defaults to "Placement Intelligence Platform").
VITE_APP_NAME=Placement Intelligence Platform

# Version string shown in the UI (optional, defaults to "1.0.0").
VITE_APP_VERSION=1.0.0

# Set to "true" to enable devtools-only UI/debug affordances (optional, defaults to false).
VITE_ENABLE_DEVTOOLS=false
